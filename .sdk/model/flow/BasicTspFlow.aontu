# BasicTspFlow

main: kit: flow: BasicTspFlow:
{
  entity: "tsp",
  kind: "basic",
  name: "BasicTspFlow",
  step: [
    {
      i: {
        ref: "tsp_ref01"
      }

      m: {
        user_id: "user01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "tsp_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tsp_ref01",
        srcdatavar: "tsp_ref01_data",
        suffix: "_up0",
        textfield: "code"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tsp_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tsp_ref01",
        srcdatavar: "tsp_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "tsp01",
        user_id: "user01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tsp_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tsp_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "tsp01",
        user_id: "user01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tsp_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTspFlow"
}