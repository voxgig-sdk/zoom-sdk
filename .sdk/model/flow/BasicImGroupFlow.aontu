    {
      i: {
        ref: "im_group_ref01"
      }

      m: {
        group_id: "group01"
      }

      o: "create"
    }

    {
      i: {
        ref: "im_group_ref01",
        srcdatavar: "im_group_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-im_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "im_group_ref01",
        srcdatavar: "im_group_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "im_group01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-im_group_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "im_group_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "im_group01"
      }

      o: "remove"
    }
  ],
  "key$": "BasicImGroupFlow"
}