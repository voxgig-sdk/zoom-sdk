# BasicAccountFlow

main: kit: flow: BasicAccountFlow:
{
  entity: "account",
  kind: "basic",
  name: "BasicAccountFlow",
  step: [
    {
      i: {
        ref: "account_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_ref01",
        srcdatavar: "account_ref01_data",
        suffix: "_up0",
        textfield: "meeting_connectors"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_ref01",
        srcdatavar: "account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "account01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "account01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountFlow"
}