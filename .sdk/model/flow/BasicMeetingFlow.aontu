# BasicMeetingFlow

main: kit: flow: BasicMeetingFlow:
{
  entity: "meeting",
  kind: "basic",
  name: "BasicMeetingFlow",
  step: [
    {
      i: {
        ref: "meeting_ref01"
      }

      m: {
        meeting_uuid: "meeting_uuid01",
        user_id: "user01"
      }

      o: "create"
    }

    {
      m: {
        meeting_uuid: "meeting_uuid01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "meeting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "meeting_ref01",
        srcdatavar: "meeting_ref01_data",
        suffix: "_up0",
        textfield: "agenda"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-meeting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "meeting_ref01",
        srcdatavar: "meeting_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "meeting01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-meeting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "meeting_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "meeting01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        meeting_uuid: "meeting_uuid01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "meeting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMeetingFlow"
}