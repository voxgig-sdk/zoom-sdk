# Entity: zoom_room_list

main: kit: entity: zoom_room_list: {

  alias: field: {}

  fields: {
    page_count: {
      h: "Page Count"
      n: "page_count"
      r: false
      sh: "The number of items returned on this page"
      t: "`$INTEGER`"
    }
    page_number: {
      h: "Page Number"
      n: "page_number"
      r: false
      sh: "The page number of current results"
      t: "`$INTEGER`"
    }
    page_size: {
      h: "Page Size"
      n: "page_size"
      r: false
      sh: "The number of records returned within a single API call"
      t: "`$INTEGER`"
    }
    total_records: {
      h: "Total Records"
      n: "total_records"
      r: false
      sh: "The number of all records available across pages"
      t: "`$INTEGER`"
    }
    zoom_rooms: {
      h: "Zoom Rooms"
      n: "zoom_rooms"
      r: false
      sh: "Array of Zoom Rooms"
      t: "`$ARRAY`"
    }
  }

  name: "zoom_room_list"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /metrics/zoomrooms"
            source: "swagger2"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "page_number"
                or: "page_number"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/metrics/zoomrooms"
          q: {
            exist: [
              "page_number"
              "page_size"
            ]
          }
          s: [
            {
              lit: "metrics"
            }
            {
              lit: "zoomrooms"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
